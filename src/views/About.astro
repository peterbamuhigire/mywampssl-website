---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { getContent } from '../i18n/content';
import { path, type Locale } from '../i18n/ui';
import { LINKS, AUTHOR } from '../data/site';
import * as S from '../components/schema';
import peter from '../assets/images/peter-bamuhigire.jpg';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const c = getContent(lang);
const a = c.about;

const crumbs = [
  { name: 'WAMP SSL Automator', url: path('home', lang) },
  { name: c.nav.find((n) => n.key === 'about')!.label, url: path('about', lang) },
];
const jsonLd = S.graph(S.organization(), S.website(lang), S.person(), S.softwareApplication(lang), S.breadcrumb(crumbs));
---
<BaseLayout lang={lang} routeKey="about" meta={a.meta} content={c} jsonLd={jsonLd}>
  <section class="glow-green border-b border-line py-16 md:py-20">
    <div class="container-x max-w-3xl">
      <p class="eyebrow">{c.nav.find((n) => n.key === 'about')!.label}</p>
      <h1 class="mt-4 text-4xl font-bold leading-[1.08] sm:text-5xl">{a.h1}</h1>
      <p class="mt-6 text-lg text-fg-soft">{a.lead}</p>
    </div>
  </section>

  <section class="py-14 md:py-20">
    <div class="container-x max-w-3xl">
      <h2 class="text-2xl font-bold sm:text-3xl">{a.project.h2}</h2>
      {a.project.paras.map((p) => <p class="mt-5 text-fg-soft">{p}</p>)}
    </div>
  </section>

  <!-- the builder — measured, never a pitch -->
  <section class="border-y border-line bg-ink-2/30 py-14 md:py-20">
    <div class="container-x grid items-start gap-10 md:grid-cols-[auto_1fr] md:gap-12">
      <div class="shrink-0">
        <Image src={peter} alt={a.builder.photoAlt} width={360} height={360} class="h-44 w-44 rounded-2xl border border-line-2 object-cover md:h-56 md:w-56" loading="lazy" />
      </div>
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">{a.builder.h2}</h2>
        {a.builder.paras.map((p) => <p class="mt-5 max-w-2xl text-fg-soft">{p}</p>)}
        <p class="mt-6 text-sm font-semibold uppercase tracking-wider text-fg-muted">{a.builder.skillsLabel}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {a.builder.skills.map((s) => (
            <li class="rounded-full border border-line-2 bg-ink px-3 py-1.5 text-sm text-fg-soft">{s}</li>
          ))}
        </ul>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={AUTHOR.website} variant="ghost" icon="globe" iconRight="external-link" external>{a.builder.linkText}</Button>
          <Button href={LINKS.repo} variant="ghost" icon="github" external>{c.ui.viewOnGithub}</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20">
    <div class="container-x max-w-3xl">
      <h2 class="text-2xl font-bold sm:text-3xl">{a.open.h2}</h2>
      {a.open.paras.map((p) => <p class="mt-5 text-fg-soft">{p}</p>)}
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={LINKS.download} icon="download" external>{c.ui.downloadWindows}</Button>
        <Button href={LINKS.repo} icon="star" variant="ghost" external>{c.ui.starOnGithub}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
