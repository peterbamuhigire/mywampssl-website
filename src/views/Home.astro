---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import WindowFrame from '../components/WindowFrame.astro';
import LogBlock from '../components/LogBlock.astro';
import { getContent } from '../i18n/content';
import { path, type Locale } from '../i18n/ui';
import { LINKS, AUTHOR } from '../data/site';
import * as S from '../components/schema';

import screenshotEn from '../assets/images/screenshot-en.jpg';
import screenshotFr from '../assets/images/screenshot-fr.jpg';
import peter from '../assets/images/peter-bamuhigire.jpg';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const c = getContent(lang);
const h = c.home;
const shot = lang === 'fr' ? screenshotFr : screenshotEn;

const jsonLd = S.graph(
  S.organization(),
  S.website(lang),
  S.person(),
  S.softwareApplication(lang),
);
const pipelineLog = h.pipeline.steps.map((s, i) => `[${i + 1}/9] ${s.name.padEnd(11)} ${s.text.split('.')[0]}`);
---
<BaseLayout lang={lang} routeKey="home" meta={h.meta} content={c} jsonLd={jsonLd}>

  <!-- ============ HERO ============ -->
  <section class="glow-green relative overflow-hidden">
    <div class="container-x grid items-center gap-12 py-16 md:py-24 lg:grid-cols-[1.05fr_1fr] lg:gap-10">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-line-2 bg-ink-2 px-3 py-1 text-xs font-medium text-green">
          <Icon name="lucide:shield-check" class="h-3.5 w-3.5" /> {h.hero.badge}
        </span>
        <h1 class="mt-5 text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl lg:text-[3.4rem]">
          {h.hero.h1}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-fg-soft">{h.hero.sub}</p>
        <p class="mt-4 max-w-xl text-sm text-fg-muted">{h.hero.note}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={LINKS.download} icon="download" size="lg" external>{c.ui.downloadWindows}</Button>
          <Button href={LINKS.repo} icon="github" variant="ghost" size="lg" external>{c.ui.starOnGithub}</Button>
        </div>
        <ul class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-fg-muted">
          <li class="inline-flex items-center gap-2"><Icon name="lucide:badge-check" class="h-4 w-4 text-green" /> {c.ui.free}</li>
          <li class="inline-flex items-center gap-2"><Icon name="lucide:github" class="h-4 w-4 text-green" /> {c.ui.openSource}</li>
          <li class="inline-flex items-center gap-2"><Icon name="lucide:file-text" class="h-4 w-4 text-green" /> MIT</li>
          <li class="inline-flex items-center gap-2"><Icon name="lucide:app-window" class="h-4 w-4 text-green" /> Windows 10 / 11</li>
        </ul>
      </div>

      <div class="relative">
        <div class="absolute -inset-6 -z-10 rounded-3xl bg-green/10 blur-3xl"></div>
        <WindowFrame label={h.hero.screenshotAlt}>
          <Image src={shot} alt={h.hero.screenshotAlt} widths={[480, 801]} sizes="(min-width: 1024px) 40vw, 90vw" class="h-auto w-full" loading="eager" />
        </WindowFrame>
        <div class="mt-3 flex items-center justify-center gap-2 font-mono text-xs text-green">
          <Icon name="lucide:check-check" class="h-4 w-4" /> Verification: 3/3 OK
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROBLEM ============ -->
  <section class="border-y border-line bg-ink-2/30 py-16 md:py-24">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <p class="eyebrow">{h.problem.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">{h.problem.h2}</h2>
        <p class="mt-5 max-w-lg text-fg-soft">{h.problem.intro}</p>
        <!-- the "before" state -->
        <div class="mt-7 overflow-hidden rounded-xl border border-red/30 bg-red-dim/20">
          <div class="flex items-center gap-2 border-b border-red/20 px-4 py-2.5 text-red">
            <Icon name="lucide:triangle-alert" class="h-4 w-4" />
            <span class="text-sm font-semibold">Your connection is not private</span>
          </div>
          <p class="px-4 py-3 font-mono text-xs text-fg-muted">NET::ERR_CERT_AUTHORITY_INVALID — <span class="text-red">Proceed anyway (unsafe)</span></p>
        </div>
      </div>
      <div>
        <ul class="space-y-4">
          {h.problem.bullets.map((b) => (
            <li class="flex gap-3 rounded-xl border border-line bg-ink-2/50 p-4">
              <Icon name="lucide:circle-x" class="mt-0.5 h-5 w-5 shrink-0 text-red" />
              <span class="text-fg-soft">{b}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-fg-soft">{h.problem.close}</p>
      </div>
    </div>
  </section>

  <!-- ============ SOLUTION ============ -->
  <section class="py-16 md:py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow">{h.solution.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">{h.solution.h2}</h2>
        <p class="mt-5 text-fg-soft">{h.solution.intro}</p>
      </div>
      <div class="mt-10 grid gap-3 md:grid-cols-2">
        {h.solution.gains.map((g) => (
          <div class="flex gap-3 rounded-xl border border-line bg-ink-2/40 p-4">
            <Icon name="lucide:circle-check" class="mt-0.5 h-5 w-5 shrink-0 text-green" />
            <span class="text-fg-soft">{g}</span>
          </div>
        ))}
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {h.solution.safety.map((s) => (
          <div class="card card-hover p-5">
            <Icon name="lucide:shield" class="h-6 w-6 text-green" />
            <p class="mt-3 text-sm leading-relaxed text-fg-soft">{s}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 max-w-2xl text-lg font-medium text-fg">{h.solution.close}</p>
    </div>
  </section>

  <!-- ============ TRUST ============ -->
  <section class="relative overflow-hidden border-y border-line bg-ink-2/30 py-16 md:py-24">
    <div class="container-x grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow">{h.trust.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">{h.trust.h2}</h2>
        {h.trust.paras.map((p) => <p class="mt-5 text-fg-soft">{p}</p>)}
      </div>
      <!-- CA → certs visual -->
      <div class="card p-6 md:p-8">
        <div class="flex items-center gap-3">
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-green/15 text-green"><Icon name="lucide:shield-check" class="h-6 w-6" /></span>
          <div>
            <p class="font-display font-semibold text-fg">Your local Root CA</p>
            <p class="font-mono text-xs text-fg-muted">RSA-4096 · installed once · never leaves your machine</p>
          </div>
        </div>
        <div class="my-4 ml-6 h-6 w-px bg-line-2"></div>
        <div class="space-y-2.5">
          {['myapp.test', 'shop.test', 'api.test'].map((d) => (
            <div class="flex items-center justify-between rounded-lg border border-line bg-ink px-4 py-2.5">
              <span class="flex items-center gap-2 font-mono text-sm text-fg-soft"><Icon name="lucide:lock" class="h-4 w-4 text-green" /> {d}</span>
              <span class="font-mono text-xs text-green">trusted</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FEATURES ============ -->
  <section class="py-16 md:py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow">{h.features.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">{h.features.h2}</h2>
        <p class="mt-5 text-fg-soft">{h.features.sub}</p>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {h.features.items.map((f) => (
          <div class="card card-hover flex flex-col p-5">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-green/12 text-green"><Icon name={`lucide:${f.icon}`} class="h-5 w-5" /></span>
            <h3 class="mt-4 font-display text-base font-semibold text-fg">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{f.body}</p>
          </div>
        ))}
      </div>
      <div class="mt-8">
        <a href={path('features', lang)} class="inline-flex items-center gap-1.5 font-display font-semibold text-green transition-all hover:gap-2.5"><span>{c.nav.find((n)=>n.key==='features')!.label}</span><Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
      </div>
    </div>
  </section>

  <!-- ============ PIPELINE ============ -->
  <section class="border-y border-line bg-ink-2/30 py-16 md:py-24">
    <div class="container-x grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow">{h.pipeline.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">{h.pipeline.h2}</h2>
        <p class="mt-5 text-fg-soft">{h.pipeline.sub}</p>
        <div class="mt-7">
          <Button href={path('howItWorks', lang)} variant="ghost" iconRight="arrow-right">{h.pipeline.cta}</Button>
        </div>
      </div>
      <LogBlock lines={pipelineLog} />
    </div>
  </section>

  <!-- ============ QUICK START ============ -->
  <section class="py-16 md:py-24">
    <div class="container-x max-w-3xl">
      <p class="eyebrow">{h.quickstart.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">{h.quickstart.h2}</h2>
      <p class="mt-5 text-fg-soft">{h.quickstart.sub}</p>
      <ol class="mt-8 space-y-4">
        {h.quickstart.steps.map((step, i) => (
          <li class="flex gap-4">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-green/30 bg-green/10 font-mono text-sm font-semibold text-green">{i + 1}</span>
            <span class="pt-1.5 text-fg-soft">{step}</span>
          </li>
        ))}
      </ol>
      <div class="mt-8 rounded-xl border border-green/25 bg-green/5 p-5">
        <p class="flex items-start gap-2.5 text-fg"><Icon name="lucide:check-check" class="mt-1 h-5 w-5 shrink-0 text-green" />{h.quickstart.outro}</p>
      </div>
    </div>
  </section>

  <!-- ============ BUILDER (subtle, ~20%) ============ -->
  <section class="border-t border-line py-16 md:py-24">
    <div class="container-x grid items-center gap-10 md:grid-cols-[auto_1fr] md:gap-12">
      <Image src={peter} alt={h.builder.photoAlt} width={300} height={300} class="h-40 w-40 rounded-2xl border border-line-2 object-cover md:h-48 md:w-48" loading="lazy" />
      <div>
        <p class="eyebrow">{h.builder.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">{h.builder.h2}</h2>
        {h.builder.paras.map((p) => <p class="mt-4 max-w-2xl text-fg-soft">{p}</p>)}
        <a href={path('about', lang)} class="mt-5 inline-flex items-center gap-1.5 font-display font-semibold text-cyan hover:gap-2.5 transition-all">{h.builder.link}<Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
      </div>
    </div>
  </section>

  <!-- ============ PALESTINE (compact, ~10%) ============ -->
  <section class="border-t border-line bg-ink-2/30 py-14">
    <div class="container-x">
      <a href={path('palestine', lang)} class="group block rounded-2xl border border-line bg-ink-2/50 p-7 transition-colors hover:border-green/40 md:p-9">
        <p class="eyebrow flex items-center gap-2"><Icon name="lucide:heart" class="h-4 w-4" /> {h.palestine.eyebrow}</p>
        <h2 class="mt-3 max-w-3xl text-2xl font-bold sm:text-3xl">{h.palestine.h2}</h2>
        <p class="mt-4 max-w-2xl text-fg-soft">{h.palestine.body}</p>
        <span class="mt-4 inline-flex items-center gap-1.5 font-display font-semibold text-green group-hover:gap-2.5 transition-all">{h.palestine.link}<Icon name="lucide:arrow-right" class="h-4 w-4" /></span>
      </a>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="glow-green py-20 md:py-28">
    <div class="container-x text-center">
      <h2 class="mx-auto max-w-2xl text-3xl font-bold sm:text-4xl lg:text-5xl">{h.finalCta.h2}</h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-fg-soft">{h.finalCta.sub}</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button href={LINKS.download} icon="download" size="lg" external>{c.ui.downloadWindows}</Button>
        <Button href={LINKS.repo} icon="star" variant="ghost" size="lg" external>{c.ui.starOnGithub}</Button>
      </div>
    </div>
  </section>

</BaseLayout>
