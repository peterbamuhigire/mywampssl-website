---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { getContent } from '../i18n/content';
import { path, type Locale } from '../i18n/ui';
import { LINKS } from '../data/site';
import * as S from '../components/schema';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const c = getContent(lang);
const w = c.howItWorks;

const crumbs = [
  { name: 'WAMP SSL Automator', url: path('home', lang) },
  { name: c.nav.find((n) => n.key === 'howItWorks')!.label, url: path('howItWorks', lang) },
];
const jsonLd = S.graph(
  S.organization(), S.website(lang), S.person(), S.softwareApplication(lang),
  S.howTo(w.h1, w.steps, lang), S.breadcrumb(crumbs),
);
---
<BaseLayout lang={lang} routeKey="howItWorks" meta={w.meta} content={c} jsonLd={jsonLd}>
  <section class="glow-green border-b border-line py-16 md:py-20">
    <div class="container-x max-w-3xl">
      <p class="eyebrow">{c.nav.find((n) => n.key === 'howItWorks')!.label}</p>
      <h1 class="mt-4 text-4xl font-bold leading-[1.08] sm:text-5xl">{w.h1}</h1>
      <p class="mt-6 text-lg text-fg-soft">{w.lead}</p>
    </div>
  </section>

  <section class="py-14 md:py-20">
    <div class="container-x max-w-4xl">
      <ol class="relative space-y-5 border-l border-line pl-8 md:pl-10">
        {w.steps.map((s, i) => (
          <li class="relative">
            <span class="absolute -left-[2.65rem] grid h-9 w-9 place-items-center rounded-full border border-green/30 bg-ink font-mono text-sm font-semibold text-green md:-left-[3.15rem]">{i + 1}</span>
            <div class="card p-5 md:p-6">
              <h2 class="font-display text-lg font-semibold text-fg">{s.name}</h2>
              <p class="mt-2 text-fg-soft">{s.text}</p>
              <p class="mt-3 rounded-lg border border-line bg-[#060b14] px-3 py-2 font-mono text-xs text-fg-soft"><span class="log-dim">&rsaquo; </span><span class={/OK|running|ready|present|Syntax OK/i.test(s.log) ? 'log-ok' : ''}>{s.log}</span></p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-y border-line bg-ink-2/30 py-16 md:py-20">
    <div class="container-x max-w-3xl">
      <h2 class="text-3xl font-bold sm:text-4xl">{w.safety.h2}</h2>
      {w.safety.paras.map((p) => <p class="mt-5 text-fg-soft">{p}</p>)}
    </div>
  </section>

  <section class="glow-green py-16 text-center md:py-20">
    <div class="container-x">
      <h2 class="mx-auto max-w-xl text-3xl font-bold sm:text-4xl">{w.cta.h2}</h2>
      <p class="mx-auto mt-4 max-w-lg text-fg-soft">{w.cta.sub}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href={LINKS.download} icon="download" size="lg" external>{c.ui.downloadWindows}</Button>
        <Button href={path('guideSsl', lang)} variant="ghost" size="lg" iconRight="arrow-right">{c.ui.readGuide}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
