---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { getContent } from '../i18n/content';
import { path, type Locale } from '../i18n/ui';
import { LINKS } from '../data/site';
import * as S from '../components/schema';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const c = getContent(lang);
const f = c.features;

const crumbs = [
  { name: 'WAMP SSL Automator', url: path('home', lang) },
  { name: c.nav.find((n) => n.key === 'features')!.label, url: path('features', lang) },
];
const jsonLd = S.graph(S.organization(), S.website(lang), S.person(), S.softwareApplication(lang), S.breadcrumb(crumbs));
---
<BaseLayout lang={lang} routeKey="features" meta={f.meta} content={c} jsonLd={jsonLd}>
  <section class="glow-green border-b border-line py-16 md:py-20">
    <div class="container-x max-w-3xl">
      <p class="eyebrow">{c.nav.find((n) => n.key === 'features')!.label}</p>
      <h1 class="mt-4 text-4xl font-bold leading-[1.08] sm:text-5xl">{f.h1}</h1>
      <p class="mt-6 text-lg text-fg-soft">{f.lead}</p>
    </div>
  </section>

  <section class="py-14 md:py-20">
    <div class="container-x">
      <div class="grid gap-5 md:grid-cols-2">
        {f.items.map((item) => (
          <article class="card card-hover flex flex-col p-6 md:p-7">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-green/12 text-green"><Icon name={`lucide:${item.icon}`} class="h-6 w-6" /></span>
            <h2 class="mt-5 font-display text-xl font-semibold text-fg">{item.title}</h2>
            <p class="mt-2 font-medium text-fg-soft">{item.body}</p>
            <p class="mt-3 text-sm leading-relaxed text-fg-muted">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="glow-green border-t border-line py-16 text-center md:py-20">
    <div class="container-x">
      <h2 class="mx-auto max-w-xl text-3xl font-bold sm:text-4xl">{f.cta.h2}</h2>
      <p class="mx-auto mt-4 max-w-lg text-fg-soft">{f.cta.sub}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href={LINKS.download} icon="download" size="lg" external>{c.ui.downloadWindows}</Button>
        <Button href={path('howItWorks', lang)} variant="ghost" size="lg" iconRight="arrow-right">{c.nav.find((n) => n.key === 'howItWorks')!.label}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
