---
import { Icon } from 'astro-icon/components';
interface Props { address?: string; class?: string; label?: string; }
const { address = 'https://myapp.test', class: cls = '', label } = Astro.props;
---
<figure class={`overflow-hidden rounded-xl border border-line-2 bg-ink-2 shadow-card ${cls}`}>
  <div class="flex items-center gap-3 border-b border-line bg-ink-3/70 px-4 py-2.5">
    <div class="flex gap-1.5" aria-hidden="true">
      <span class="h-3 w-3 rounded-full bg-red/70"></span>
      <span class="h-3 w-3 rounded-full bg-amber/70"></span>
      <span class="h-3 w-3 rounded-full bg-green/70"></span>
    </div>
    <div class="flex min-w-0 flex-1 items-center gap-2 rounded-md border border-line bg-ink px-3 py-1">
      <Icon name="lucide:lock" class="h-3.5 w-3.5 shrink-0 text-green" aria-hidden="true" />
      <span class="truncate font-mono text-xs text-fg-soft">{address}</span>
    </div>
  </div>
  <div class="bg-ink">
    <slot />
  </div>
  {label && <figcaption class="sr-only">{label}</figcaption>}
</figure>
