---
import { Icon } from 'astro-icon/components';
import type { Faq } from '../i18n/types';
interface Props { items: Faq[]; class?: string; }
const { items, class: cls = '' } = Astro.props;
---
<div class={`divide-y divide-line rounded-2xl border border-line bg-ink-2/50 ${cls}`}>
  {items.map((item, i) => (
    <details class="group" name="faq" open={i === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left font-display font-semibold text-fg transition-colors hover:text-green md:px-6 md:py-5">
        <span>{item.q}</span>
        <Icon name="lucide:chevron-down" class="h-5 w-5 shrink-0 text-fg-muted transition-transform duration-300 group-open:rotate-180" aria-hidden="true" />
      </summary>
      <div class="px-5 pb-5 text-fg-soft md:px-6 md:pb-6">
        <p class="max-w-2xl leading-relaxed">{item.a}</p>
      </div>
    </details>
  ))}
</div>
